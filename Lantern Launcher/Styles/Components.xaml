<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The one global tooltip: a small ink bubble, dark against every surface.
         Static shadow only; an animated Effect would re-run the blur each frame. -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#3A3F47" CornerRadius="6" Padding="8,5">
                        <Border.Effect>
                            <DropShadowEffect Color="#33383F" BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                        </Border.Effect>
                        <ContentPresenter TextElement.Foreground="#FFFFFF" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
