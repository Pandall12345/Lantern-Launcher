    <!-- Stroked icons follow the host Foreground, so they recolour on hover for free -->
    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>

    <Style x:Key="IconStrokeMute" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{StaticResource MuteBrush}" />
    </Style>

    <Style x:Key="IconStrokeInk" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="Stroke" Value="{StaticResource InkBrush}" />
    </Style>


    <!-- Filled icons (play triangle, overflow dots) -->

    <!-- Status icons, 16x16 canvas, 1.5 round stroke -->

    <!-- Nav icons switch to the accent colour when selected -->
    <Style x:Key="NavIconPath" TargetType="Path" BasedOn="{StaticResource IconStroke}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Stroke" Value="{StaticResource MuteBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="True">
                <Setter Property="Stroke" Value="{StaticResource BodyTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
