<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Kyoto First Snow. Pale warm white for paper, slate blue for ink, blue-grey for lines.
         Every colour in the app comes from here; a page that hard-codes a hex value is a bug. -->

    <!-- Surfaces (four steps, each closed by a 1px hairline) -->
    <SolidColorBrush x:Key="CanvasBrush"          Color="#F8F9FA" />
    <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#EDF1F4" />
    <SolidColorBrush x:Key="SurfaceCardBrush"     Color="#E7ECF1" />

    <!-- Strokes and dividers -->
    <SolidColorBrush x:Key="HairlineBrush"       Color="#E0E0E0" />
    <SolidColorBrush x:Key="HairlineSoftBrush"   Color="#ECEDEE" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#CBD2D9" />
    <SolidColorBrush x:Key="ControlOutlineBrush" Color="#C2CAD2" />

    <!-- Text: primary #333, secondary #666, muted -->
    <SolidColorBrush x:Key="InkBrush"         Color="#333333" />
    <SolidColorBrush x:Key="BodyTextBrush"    Color="#666666" />
    <SolidColorBrush x:Key="MuteBrush"        Color="#7C828A" />
    <SolidColorBrush x:Key="AshBrush"         Color="#9AA1A9" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#8A9199" />
    <SolidColorBrush x:Key="StoneBrush"       Color="#C2C8CE" />

    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#454E59" />

    <SolidColorBrush x:Key="AccentBrush"      Color="#8890A0" />
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#E4E9EF" />

    <!-- Text on the pale hover fill (#D4E0E8 leaves white text at 1.5:1, so it has to go dark) -->

    <!-- Semantic colours, tuned into the same warm-grey scale -->
    <SolidColorBrush x:Key="SuccessBrush"     Color="#4C8C6B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F0EA" />
    <SolidColorBrush x:Key="DangerBrush"      Color="#B85C5C" />
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#F6E8E8" />
    <SolidColorBrush x:Key="WarningBrush"     Color="#B0862F" />

    <!-- Card outline: a white card on #F8F9FA is only 1.02:1, so it gets its own step  -->
    <SolidColorBrush x:Key="CardLineBrush" Color="#D9DEE4" />

    <!-- Skeleton fill: one step below SurfaceCard so the sweep has visible contrast -->
    <SolidColorBrush x:Key="SkeletonFillBrush" Color="#DCE3EA" />

    <!-- Misc -->
    <SolidColorBrush x:Key="OnDarkBrush" Color="#333333" />


    <!-- Frost gradient over images: only the text side, the right side stays clear -->

    <!-- Detail pages: diagonal wash from the top-left, keeping the bottom-right image readable -->
    <LinearGradientBrush x:Key="FrostOverlayDiagonalBrush" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#F2F8F9FA" Offset="0.05" />
        <GradientStop Color="#A6F8F9FA" Offset="0.55" />
        <GradientStop Color="#00F8F9FA" Offset="1" />
    </LinearGradientBrush>

    <!-- Radii -->

    <!-- Sizes -->

    <!-- Spacing (4px base) -->
    <Thickness x:Key="PagePadding">32,28,32,48</Thickness>

    <sys:Double x:Key="ContentMaxWidth">1200</sys:Double>

</ResourceDictionary>
