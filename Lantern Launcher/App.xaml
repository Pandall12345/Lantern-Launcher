<Application x:Class="LanternLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LanternLauncher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Motion.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Inputs.xaml" />
                <ResourceDictionary Source="Styles/Surfaces.xaml" />
                <ResourceDictionary Source="Styles/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:LoadStateToVisibility x:Key="StateToVis" />
            <local:BoolToVisibility x:Key="BoolToVis" />
            <local:CountToVisibility x:Key="CountToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
