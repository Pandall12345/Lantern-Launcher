<UserControl x:Class="LanternLauncher.Controls.SkeletonTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Host" Background="{StaticResource SkeletonFillBrush}" ClipToBounds="True">
        <Border x:Name="Band" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BandShift" X="-200" />
            </Border.RenderTransform>
        </Border>
    </Grid>
</UserControl>
