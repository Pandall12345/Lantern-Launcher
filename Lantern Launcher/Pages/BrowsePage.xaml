<UserControl x:Class="LanternLauncher.Pages.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanternLauncher.Controls"
             xmlns:local="clr-namespace:LanternLauncher.Common">

    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                  Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    MaxWidth="{StaticResource ContentMaxWidth}">

            <!-- search -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchInput" Grid.Column="0" Style="{StaticResource SearchBox}"
                         Tag="Search Modrinth…  (Enter)"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchInput_KeyDown" />

                <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxDark}" Width="168" Margin="12,0,0,0"
                          ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxDark}" Width="160" Margin="8,0,0,0"
                          ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" />
                <ComboBox Grid.Column="3" Style="{StaticResource ComboBoxDark}" Width="160" Margin="8,0,0,0"
                          ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                          Visibility="{Binding IsLoaderVisible, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- type chips + count -->
            <Grid Margin="0,16,0,0">
                <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Types}"
                         SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding TotalText}" Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Loading: identical geometry to the real list (one card, seven 84px rows, 1px dividers), so nothing shifts when it arrives -->
            <Border Margin="0,16,0,0" CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                    Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                <ItemsControl ItemsSource="{Binding SkeletonRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,0,0,1">
                                <Grid Height="84" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" VerticalAlignment="Center">
                                        <controls:SkeletonTile
                                                Width="46" Height="46" Radius="9" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <controls:SkeletonTile Height="12" Width="180"
                                                Radius="4" HorizontalAlignment="Left" />
                                        <controls:SkeletonTile Height="10" Width="360"
                                                Radius="4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Margin="0,16,0,0" CornerRadius="12" ClipToBounds="True"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                    Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource CardLineBrush}" BorderThickness="0,0,0,1">
                                <Grid Height="84" Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}"
                                            BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                        <controls:AsyncIcon Source="{Binding IconUrl}"
                                                            Width="46" Height="46" Radius="9" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource TextSmallStrong}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaptionSm}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource TextCaptionSm}"
                                                   Foreground="{StaticResource StoneBrush}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource TextSmall}"
                                                   Foreground="{StaticResource BodyTextBrush}" />
                                        <TextBlock Text="downloads" Style="{StaticResource TextCaptionSm}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="3" Style="{StaticResource ButtonSecondary}" Content="View"
                                            Height="32" FontSize="13" Padding="16,0" MinWidth="76"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Pagination: seven per page, page number with previous and next -->
            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ButtonSecondary}" Content="Previous"
                            Height="32" FontSize="13" Padding="14,0" MinWidth="96"
                            Click="Prev_Click" IsEnabled="{Binding CanPrev}" />

                    <TextBlock Text="{Binding PageText}" Style="{StaticResource TextSmall}"
                               VerticalAlignment="Center" Margin="16,0" MinWidth="96"
                               TextAlignment="Center" />

                    <Button Style="{StaticResource ButtonSecondary}" Content="Next"
                            Height="32" FontSize="13" Padding="14,0" MinWidth="96"
                            Click="Next_Click" IsEnabled="{Binding CanNext}" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
