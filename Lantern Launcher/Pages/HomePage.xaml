<UserControl x:Class="LanternLauncher.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanternLauncher.Controls"
             xmlns:local="clr-namespace:LanternLauncher.Common">

    <UserControl.Resources>
        <!-- Card used inside the strips: icon, title, one line of meta.
             Hover raises the surface one step and brightens the meta; nothing resizes, so the layout never jumps. -->
        <Style x:Key="RailCardButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:AsyncIcon Source="{Binding IconUrl}"
                                                    Width="44" Height="44" Radius="10" VerticalAlignment="Center" />

                                <StackPanel x:Name="meta" Grid.Column="1" Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource TextSmallStrong}"
                                               TextWrapping="Wrap" MaxHeight="36"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}" />
                                    <TextBlock x:Name="sub" Style="{StaticResource TextCaptionSm}"
                                               Margin="0,4,0,0" Foreground="{StaticResource MuteBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DownloadsText, Mode=OneWay}" />
                                        <Run Text=" downloads" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="sub"
                                                             Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                             To="#333333" Duration="0:0:0.18">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="sub"
                                                             Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                             To="#7C828A" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quiet link: muted by default, darkens on hover, so one screen does not end up with four accents -->
        <Style x:Key="QuietLink" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextElement.Foreground>
                                    <SolidColorBrush Color="#7C828A" />
                                </TextElement.Foreground>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="cp"
                                                            Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                            To="#333333" Duration="0:0:0.15">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="cp"
                                                            Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                            To="#7C828A" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- News card: the image bleeds to the card edge and the card clips the corners -->
        <Style x:Key="NewsCardButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="12" local:RoundedClip.Radius="12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NewsCard">
            <Button Style="{StaticResource NewsCardButton}" HorizontalAlignment="Stretch"
                    Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <controls:AsyncIcon Source="{Binding Image}" Height="96" Radius="0" />
                    <StackPanel Margin="14,12,14,14">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextSmallStrong}"
                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <TextBlock Text="{Binding BylineText}" Style="{StaticResource TextCaptionSm}"
                                   Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- An ItemsControl needs a DataTemplate, so a Button rendered with the style above sits inside it -->
        <DataTemplate x:Key="RailCard">
            <Button Style="{StaticResource RailCardButton}"
                    Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                  Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    MaxWidth="{StaticResource ContentMaxWidth}">

            <!-- Daily greeting -->
            <TextBlock Text="{Binding GreetingText}" Style="{StaticResource TextDisplay}"
                       FontSize="34" LineHeight="40" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource TextBody}" FontSize="13" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis">
                <Run Text="{Binding DateLine, Mode=OneWay}" />
                <Run Text="  ·  " Foreground="{StaticResource StoneBrush}" />
                <Run Text="{Binding StatusText, Mode=OneWay}" />
            </TextBlock>
            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,16,0,0" />

            <!-- News: four cards, at the top -->
            <StackPanel Visibility="{Binding HasNews, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="From minecraft.net" Style="{StaticResource TextCaptionSm}" Margin="0,24,0,0" />
                <ItemsControl ItemsSource="{Binding NewsTop}" Margin="0,12,0,0"
                              ItemTemplate="{StaticResource NewsCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>

            <!-- Strip one: popular modpacks -->
            <StackPanel Visibility="{Binding ShowStrips, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,24,0,0">
                    <TextBlock Text="Popular modpacks" Style="{StaticResource TextH2}" />
                    <Button Style="{StaticResource QuietLink}" Content="See all"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenModpacksCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding SkeletonRail}" Margin="0,12,0,0"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SkeletonTile Height="68" Radius="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding PopularPacks}" Margin="0,12,0,0"
                              ItemTemplate="{StaticResource RailCard}"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>

            <!-- Strip two: new and updated -->
            <StackPanel Visibility="{Binding ShowStrips, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,24,0,0">
                    <TextBlock Text="New &amp; updated" Style="{StaticResource TextH2}" />
                    <Button Style="{StaticResource QuietLink}" Content="See all"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenBrowseCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding SkeletonRail}" Margin="0,12,0,0"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SkeletonTile Height="68" Radius="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding FreshMods}" Margin="0,12,0,0"
                              ItemTemplate="{StaticResource RailCard}"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>

            <!-- Footer: other worlds and one news row -->
            <Border Height="1" Background="{StaticResource HairlineSoftBrush}" Margin="0,24,0,0" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Visibility="{Binding Worlds.Count, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="Your worlds" Style="{StaticResource TextCaptionSm}"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Worlds}" Margin="12,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuietLink}" Content="{Binding Name}" FontSize="12"
                                        Margin="0,0,12,0"
                                        Command="{Binding DataContext.OpenWorldCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
