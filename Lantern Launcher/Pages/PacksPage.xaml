<UserControl x:Class="LanternLauncher.Pages.PacksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanternLauncher.Controls"
             xmlns:local="clr-namespace:LanternLauncher.Common">

    <UserControl.Resources>
        <!-- Modpack row card: 48px icon, title, one line of mono meta. Shared by the three-column grid and the result list. -->
        <DataTemplate x:Key="PackRow">
            <Button Style="{StaticResource RowCardButton}" Padding="14" Margin="0,0,12,12"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                            CornerRadius="10">
                        <controls:AsyncIcon Source="{Binding IconUrl}"
                                                 Width="46" Height="46" Radius="9" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource TextSmallStrong}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <TextBlock Style="{StaticResource TextCaptionSm}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding DownloadsText, Mode=OneWay}" />
                            <Run Text=" downloads  ·  " Foreground="{StaticResource StoneBrush}" />
                            <Run Text="{Binding CategoriesText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                  Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    MaxWidth="{StaticResource ContentMaxWidth}">

            <!-- Header: title and search -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Modpacks" Style="{StaticResource TextH1}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource TextCaptionSm}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <TextBox Grid.Column="1" x:Name="SearchInput" Style="{StaticResource SearchBox}"
                         Width="320" Tag="Search modpacks"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <!-- Filters -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <ComboBox Style="{StaticResource ComboBoxDark}" Width="150"
                          ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" />
                <ComboBox Style="{StaticResource ComboBoxDark}" Width="160" Margin="8,0,0,0"
                          ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
                <Button Style="{StaticResource ButtonLink}" Content="Clear" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}"
                        Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- Featured (no search term)
                 The heading is always present; only the card area switches between skeleton and real content,
                 so the page does not jump down when loading finishes. -->
            <StackPanel Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVis}}">

                <TextBlock Text="Popular now" Style="{StaticResource TextH2}" Margin="0,32,0,0" />

                <Border Margin="0,16,0,0" Padding="20" CornerRadius="12" Height="136"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:SkeletonTile Grid.Column="0"
                                Width="96" Height="96" Radius="16" />
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <controls:SkeletonTile Height="16" Width="240"
                                    Radius="4" HorizontalAlignment="Left" />
                            <controls:SkeletonTile Height="10" Width="420"
                                    Radius="4" Margin="0,12,0,0" HorizontalAlignment="Left" />
                            <controls:SkeletonTile Height="10" Width="280"
                                    Radius="4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,16,0,0" Padding="20" CornerRadius="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="16">
                            <controls:AsyncIcon Source="{Binding Top.IconUrl}"
                                                 Width="94" Height="94" Radius="15" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Top.Title}" Style="{StaticResource TextH2}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Top.Description}" Style="{StaticResource TextSmall}"
                                       TextWrapping="Wrap" MaxHeight="42" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource TextCaptionSm}" Margin="0,8,0,0">
                                <Run Text="{Binding Top.DownloadsText, Mode=OneWay}" />
                                <Run Text=" downloads  ·  " Foreground="{StaticResource StoneBrush}" />
                                <Run Text="{Binding Top.CategoriesText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="View"
                                VerticalAlignment="Center" MinWidth="88"
                                Command="{Binding OpenCommand}" CommandParameter="{Binding Top}" />
                    </Grid>
                </Border>

                <TextBlock Text="More popular" Style="{StaticResource TextH2}" Margin="0,32,0,0" />

                <ItemsControl ItemsSource="{Binding SkeletonCards}" Margin="0,16,0,0"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,12,12" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" CornerRadius="12" Height="76"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:SkeletonTile Grid.Column="0"
                                            Width="48" Height="48" Radius="10" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <controls:SkeletonTile Height="12" Width="150"
                                                Radius="4" HorizontalAlignment="Left" />
                                        <controls:SkeletonTile Height="10" Width="110"
                                                Radius="4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Popular}" Margin="0,16,0,0"
                              ItemTemplate="{StaticResource PackRow}"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Search results (with a search term) -->
            <StackPanel Visibility="{Binding HasQuery, Converter={StaticResource BoolToVis}}">

                <Border Margin="0,24,0,0" Padding="16" CornerRadius="12"
                        Background="{StaticResource DangerSoftBrush}"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Error}">
                    <StackPanel>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource TextSmall}"
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource ButtonLink}" Content="Retry" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Command="{Binding RetryCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,48,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Empty}">
                    <TextBlock Text="No modpacks found" Style="{StaticResource TextH2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Try another keyword, or loosen the loader and version filters" Style="{StaticResource TextSmall}"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Results}" Margin="0,24,0,0"
                              ItemTemplate="{StaticResource PackRow}"
                              Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
