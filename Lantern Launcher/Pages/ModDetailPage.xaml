<UserControl x:Class="LanternLauncher.Pages.ModDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanternLauncher.Controls"
             xmlns:local="clr-namespace:LanternLauncher.Common">

    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                  Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch"
                    MaxWidth="{StaticResource ContentMaxWidth}">

            <!-- back -->
            <Button Style="{StaticResource ButtonLink}" HorizontalAlignment="Left"
                    Command="{Binding BackCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconChevronLeft}" Width="12" Height="12"
                               Style="{StaticResource IconStroke}" Stroke="{StaticResource AccentBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="Back" Style="{StaticResource TextSmall}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Button>

            <!-- header -->
            <Border CornerRadius="16" ClipToBounds="True" Height="196" Margin="0,16,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1">
                <Grid>
                    <Image Source="{Binding Project.IconUrl}" Stretch="Uniform" Opacity="0.16" />
                    <Border Background="{StaticResource FrostOverlayDiagonalBrush}" />

                    <Grid Margin="28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="88" Height="88" CornerRadius="16"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <controls:AsyncIcon Source="{Binding Project.IconUrl}"
                                                 Width="86" Height="86" Radius="15" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Project.DisplayTitle}" Style="{StaticResource TextH1}"
                                   ToolTip="{Binding Project.Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Project.Description}" Style="{StaticResource TextSmall}"
                                       TextWrapping="Wrap" MaxHeight="44" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource TagChip}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Project.ProjectType}" Style="{StaticResource TagText}" />
                                </Border>
                                <TextBlock Text="{Binding Project.DownloadsText}" Style="{StaticResource TextCaptionSm}"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="downloads" Style="{StaticResource TextCaptionSm}"
                                           Foreground="{StaticResource StoneBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="  ·  " Style="{StaticResource TextCaptionSm}"
                                           Foreground="{StaticResource StoneBrush}" />
                                <TextBlock Text="{Binding Project.Author}" Style="{StaticResource TextCaptionSm}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0"
                                    Command="{Binding OpenWebsiteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconExternal}" Width="14" Height="14"
                                          Style="{StaticResource IconStrokeInk}" Margin="0,0,8,0" />
                                    <TextBlock Text="Modrinth" Style="{StaticResource TextSmall}"
                                               Foreground="{StaticResource OnDarkBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ButtonPrimary}"
                                    Content="Download latest"
                                    Command="{Binding DownloadLatestCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- states -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0"
                        Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Loading}">
                <controls:SkeletonTile Width="560" Height="240" Margin="0,0,16,0" Radius="12" />
                <controls:SkeletonTile Width="360" Height="240" Radius="12" />
            </StackPanel>

            <Border Style="{StaticResource CardBorderFlat}" Margin="0,24,0,0"
                    Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Error}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource TextSmall}"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- body + sidebar -->
            <Grid Margin="0,24,0,0"
                  Visibility="{Binding State, Converter={StaticResource StateToVis}, ConverterParameter=Ready}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="About this project" Style="{StaticResource TextH3}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding Body}" Style="{StaticResource TextSmall}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Versions" Style="{StaticResource TextH3}" Margin="20,16,20,8" />
                        <ItemsControl ItemsSource="{Binding Versions}" Margin="0,0,0,8" MaxHeight="640">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" Margin="20,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TextSmallStrong}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource TextCaptionSm}" Margin="0,2,0,0">
                                                <Run Text="{Binding GameVersionsText, Mode=OneWay}" />
                                                <Run Text="  ·  " Foreground="{StaticResource StoneBrush}" />
                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource ButtonIcon}"
                                                ToolTip="Save this version"
                                                Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconDownload}" Width="12" Height="12" Style="{StaticResource IconStrokeMute}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
