<UserControl x:Class="LanternLauncher.Pages.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LanternLauncher.Controls">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>

        <!-- Start action: the one filled button on this page, so it carries its own states.
             Disabled sits light instead of pretending to be pressable. -->
        <Style x:Key="StartAction" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="#59636F" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>

                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextElement.Foreground>
                                    <SolidColorBrush Color="#FFFFFF" />
                                </TextElement.Foreground>
                            </ContentPresenter>
                        </Border>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#6E7887" Duration="0:0:0.22">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#59636F" Duration="0:0:0.22">
                                                <ColorAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ColorAnimation.EasingFunction>
                                            </ColorAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.985" Duration="0:0:0.09" />
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.985" Duration="0:0:0.09" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{StaticResource StoneBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Small square button that carries one glyph. Size and radius are fixed so a row of
             them lines up whatever the icon is. -->
        <Style x:Key="GlyphButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="plate" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="plate" Property="Background"
                                        Value="{StaticResource SurfaceElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="plate" Property="Background"
                                        Value="{StaticResource SurfaceCardBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="Path" BasedOn="{StaticResource IconStrokeMute}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="None" />
        </Style>

        <Style x:Key="MetaLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Running task: one framed block, progress across it, numbers on one line below. -->
        <DataTemplate x:Key="ActiveCard">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Row="0" Grid.Column="0" Data="{StaticResource IconDownload}"
                          Style="{StaticResource Glyph}" VerticalAlignment="Center"
                          HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProgressText}"
                               Style="{StaticResource MetaLine}" Foreground="{StaticResource InkBrush}"
                               FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />

                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource GlyphButton}"
                            ToolTip="Cancel download" AutomationProperties.Name="Cancel download"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <Path Data="{StaticResource IconClose}" Style="{StaticResource Glyph}" />
                    </Button>

                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="4" Margin="0,10,0,0"
                                 Value="{Binding SmoothProgress, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBarFlat}">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="Margin" Value="0,10,0,0" />
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <controls:SkeletonTile Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                           Height="4" Radius="2" Margin="0,10,0,0"
                                           Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}}" />

                    <!-- Size shares the title's left edge; speed and ETA hang off the right edge,
                         so the three figures never read as one run-on string. -->
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MetaLine}"
                                   HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource MetaLine}"
                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="2" Text="{Binding EtaText}" Style="{StaticResource MetaLine}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Finished task: same frame, a state dot and the actions that still make sense. -->
        <DataTemplate x:Key="RecentCard">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Row="0" Grid.Column="0" Width="7" Height="7"
                             HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AshBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Style="{StaticResource GlyphButton}" ToolTip="Download again"
                                AutomationProperties.Name="Retry download"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconRefresh}" Style="{StaticResource Glyph}" />
                        </Button>
                        <Button Style="{StaticResource GlyphButton}" ToolTip="Show in folder"
                                AutomationProperties.Name="Show in folder"
                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}" />
                        </Button>
                        <Button Style="{StaticResource GlyphButton}" ToolTip="Remove from list"
                                AutomationProperties.Name="Remove from list"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconTrash}" Style="{StaticResource Glyph}" />
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MetaText}"
                               Style="{StaticResource MetaLine}" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}"
                               FontSize="11.5" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Form field: a real box, so each answer reads as its own place to type. -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="12,0"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
            <Setter Property="Margin" Value="1,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Downloads" FontSize="26" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding SummaryText}" Margin="14,0,0,4" VerticalAlignment="Bottom"
                               FontSize="12" FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource BodyTextBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonLink}" Content="Clear records" Margin="0,0,16,0"
                            Command="{Binding ClearRecordsCommand}"
                            Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ButtonSecondary}" Content="Add download"
                            Command="{Binding AddDownloadCommand}"
                            AutomationProperties.Name="Add download" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewerClean}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <StackPanel Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Active" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Active}" ItemTemplate="{StaticResource ActiveCard}" />
                    </StackPanel>

                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Recent" Style="{StaticResource SectionLabel}" />
                        <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource RecentCard}" />
                    </StackPanel>

                    <StackPanel Margin="0,64,0,0" MaxWidth="420" HorizontalAlignment="Left"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconDownload}" Style="{StaticResource Glyph}"
                              Width="22" Height="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Nothing downloaded yet" Style="{StaticResource TextH2}" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource TextSmall}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Download something from Modpacks, or paste a link with Add download." />
                        <Button Style="{StaticResource ButtonSecondary}" Content="Browse modpacks"
                                HorizontalAlignment="Left" Margin="0,20,0,0"
                                Command="{Binding BrowseModpacksCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="32,13,32,13">
                <TextBlock Text="{Binding DefaultFolder}" VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}" FontSize="11"
                           Foreground="{StaticResource StoneBrush}"
                           TextTrimming="CharacterEllipsis" />

                <Button Style="{StaticResource ButtonLink}" Content="Open downloads folder"
                        HorizontalAlignment="Right" Command="{Binding OpenFolderCommand}" />
            </Grid>
        </Border>

        <!-- Add download: fields stacked as boxes, backdrop click dismisses. -->
        <Grid x:Name="OverlayRoot" Grid.RowSpan="2" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="{StaticResource InkBrush}" Opacity="0.26"
                    MouseLeftButtonDown="OnScrimClick" />

            <Border x:Name="OverlayCard" Width="470" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform Y="0" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Add download" FontSize="17" Foreground="{StaticResource InkBrush}" />
                        <Button Style="{StaticResource GlyphButton}" HorizontalAlignment="Right"
                                ToolTip="Close" AutomationProperties.Name="Close add download"
                                Command="{Binding CloseOverlayCommand}">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource Glyph}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="URL" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldShell}" Margin="0,0,0,16">
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Download URL" />
                    </Border>

                    <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldShell}" Margin="0,0,0,16" Padding="0,0,3,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource FieldBox}"
                                     Text="{Binding NewFolder, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Save folder" />

                            <Button Grid.Column="1" Style="{StaticResource GlyphButton}"
                                    Width="28" Height="28" ToolTip="Choose folder"
                                    AutomationProperties.Name="Choose folder"
                                    Command="{Binding BrowseFolderCommand}">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource Glyph}"
                                      Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="File name" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource FieldShell}">
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="File name" />
                    </Border>

                    <TextBlock Text="{Binding OverlayError}" Margin="0,12,0,0" FontSize="12"
                               TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding HasOverlayError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource ButtonLink}" Content="Cancel"
                                Command="{Binding CloseOverlayCommand}" Margin="0,0,18,0" />
                        <Button Style="{StaticResource StartAction}" Content="Start download"
                                Command="{Binding StartCustomCommand}"
                                IsEnabled="{Binding CanStartCustom}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
