<UserControl x:Class="LanternLauncher.Pages.InstancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- World: small tile card, stretching to fill the row -->
        <DataTemplate x:Key="WorldCard">
            <Border Width="300" Height="112" Margin="0,0,12,12" CornerRadius="6"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1">
                <Grid Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="15"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Top" />

                    <TextBlock Grid.Row="1" Text="{Binding Meta}"
                               FontFamily="{StaticResource FontMono}" FontSize="11"
                               Foreground="{StaticResource MuteBrush}"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Border>
        </DataTemplate>


        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Style="{StaticResource ScrollViewerClean}"
                      Padding="{StaticResource PagePadding}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch">

                <!-- Back to library -->
                <Button Style="{StaticResource ButtonLink}" HorizontalAlignment="Left"
                        Margin="0,0,0,20" Command="{Binding BackCommand}"
                        AutomationProperties.Name="Back to Library">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource MuteBrush}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Library" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Identity: the version is the headline, status sits on the right -->
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="{Binding Version}" FontFamily="{StaticResource FontMono}"
                                   FontSize="34" Foreground="{StaticResource InkBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Title}" Margin="0,6,0,0" FontSize="14"
                                   Foreground="{StaticResource BodyTextBrush}"
                                   Visibility="{Binding ShowName, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border CornerRadius="4" Padding="8,4" Background="{StaticResource SurfaceElevatedBrush}">
                            <TextBlock Text="{Binding Loader}" FontFamily="{StaticResource FontMono}"
                                       FontSize="11" Foreground="{StaticResource BodyTextBrush}" />
                        </Border>
                        <Border CornerRadius="4" Padding="8,4" Margin="6,0,0,0"
                                Background="{StaticResource SurfaceElevatedBrush}"
                                Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Incomplete" FontFamily="{StaticResource FontMono}"
                                       FontSize="11" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Fact strip -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LAST PLAYED" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource FactValue}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource HairlineSoftBrush}" Margin="0,2,0,2" />

                    <StackPanel Grid.Column="2" Margin="26,0,0,0">
                        <TextBlock Text="PATH" Style="{StaticResource FactLabel}" />
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource FactValue}"
                                   FontFamily="{StaticResource FontMono}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Margin="0,20,0,0" Background="{StaticResource HairlineBrush}" />

                <!-- Worlds: a horizontal strip. Few worlds read better as a row than as a tall half-page column. -->
                <StackPanel Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource IconGlobe}" Style="{StaticResource IconStrokeMute}"
                              Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="Worlds" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding WorldsCount}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontMono}" FontSize="12"
                                   Foreground="{StaticResource MuteBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Worlds}" ItemTemplate="{StaticResource WorldCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Text="No worlds in this library" FontSize="13"
                               Foreground="{StaticResource MuteBrush}"
                               Visibility="{Binding HasNoWorlds, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Contents: three rows on one grid, so icon, name, count, size and action
                     line up as columns rather than drifting with the length of the label. -->
                <Border Margin="0,26,0,0" CornerRadius="6" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource CardLineBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Height="64" Margin="20,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="182" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource IconPuzzle}"
                                  Style="{StaticResource IconStrokeInk}" StrokeThickness="1.6"
                                  Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Mods" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding ModsCount}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource InkBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Grid.Column="3" Text="{Binding ModsSizeText}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource MuteBrush}"
                                       Typography.NumeralAlignment="Tabular" />

                            <Button Grid.Column="4" Style="{StaticResource ButtonLink}" Content="Manage mods"
                                    VerticalAlignment="Center" Command="{Binding OpenModsCommand}"
                                    AutomationProperties.Name="Manage mods" />
                        </Grid>
                        <Border Height="1" Margin="20,0,14,0" Background="{StaticResource HairlineSoftBrush}" />
                        <Grid Height="64" Margin="20,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="182" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource IconSun}"
                                  Style="{StaticResource IconStrokeInk}" StrokeThickness="1.6"
                                  Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Shaders" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding ShaderCountText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource InkBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Grid.Column="3" Text="{Binding ShaderSizeText}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource MuteBrush}"
                                       Typography.NumeralAlignment="Tabular" />

                            <Button Grid.Column="4" Style="{StaticResource ButtonLink}" Content="Open folder"
                                    VerticalAlignment="Center" Command="{Binding OpenShadersCommand}"
                                    AutomationProperties.Name="Open shaderpacks folder" />
                        </Grid>
                        <Border Height="1" Margin="20,0,14,0" Background="{StaticResource HairlineSoftBrush}" />
                        <Grid Height="64" Margin="20,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="182" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource IconLayers}"
                                  Style="{StaticResource IconStrokeInk}" StrokeThickness="1.6"
                                  Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Resource packs" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding PackCountText}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" FontSize="13"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource InkBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <TextBlock Grid.Column="3" Text="{Binding PackSizeText}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource MuteBrush}"
                                       Typography.NumeralAlignment="Tabular" />

                            <Button Grid.Column="4" Style="{StaticResource ButtonLink}" Content="Open folder"
                                    VerticalAlignment="Center" Command="{Binding OpenPacksCommand}"
                                    AutomationProperties.Name="Open resourcepacks folder" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer pinned to the window bottom: status on the left, actions on the right -->
        <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource CanvasBrush}">
            <Grid Margin="32,13,32,13">
                <TextBlock Text="Missing client jar. It can't be launched."
                           VerticalAlignment="Center" FontSize="12"
                           FontFamily="{StaticResource UiFont}"
                           Foreground="{StaticResource WarningBrush}"
                           Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonSecondary}" Content="Open instance folder"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Style="{StaticResource ButtonPrimary}" Content="Play" Width="116" Margin="8,0,0,0"
                            Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
