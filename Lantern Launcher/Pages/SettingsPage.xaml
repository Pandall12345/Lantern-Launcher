<UserControl x:Class="LanternLauncher.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Margin" Value="20,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource TextH3}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource ScrollViewerClean}"
                  Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="{StaticResource ContentMaxWidth}"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Left column: behaviour settings -->
            <StackPanel Grid.Column="0">

                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Height="56" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Window mode" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="Applied the next time you launch"
                                       Style="{StaticResource RowHint}" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxDark}" Width="176"
                                      ItemsSource="{Binding WindowModes}"
                                      SelectedItem="{Binding Settings.WindowMode, Mode=TwoWay}" />
                        </Grid>

                        <Border Style="{StaticResource RowSeparator}" />

                        <Grid Height="60" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reduce motion" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="Fade only, no sliding or scaling"
                                       Style="{StaticResource RowHint}" Margin="0,0,12,0" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding ReduceMotion, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Java &amp; storage" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <StackPanel>
                        <Grid Height="56" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Java runtime" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding JavaRuntime}" Style="{StaticResource RowHint}" />
                        </Grid>

                        <Border Style="{StaticResource RowSeparator}" />

                        <Grid Height="56" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cache" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding CacheSize}" Style="{StaticResource RowHint}"
                                       Margin="0,0,12,0" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="Clear"
                                    Height="32" Padding="14,0" Command="{Binding ClearCacheCommand}" />
                        </Grid>

                        <Border Style="{StaticResource RowSeparator}" />

                        <Grid Height="60" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Automatic updates" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="Checks Modrinth for loader updates on start"
                                       Style="{StaticResource RowHint}" Margin="0,0,12,0" />
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding Settings.AutoUpdate, Mode=TwoWay}" />
                        </Grid>

                        <Border Style="{StaticResource RowSeparator}" />

                        <Grid Height="56" Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Log level" Style="{StaticResource RowLabel}" />
                            <TextBlock Grid.Column="1" Text="Written to %LOCALAPPDATA%\LanternLauncher"
                                       Style="{StaticResource RowHint}" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="2" Style="{StaticResource ComboBoxDark}" Width="176"
                                      ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding Settings.LogLevel, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Search projects" Style="{StaticResource TextSmall}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource KeycapBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                </Border>
                                <Border Style="{StaticResource KeycapBorder}" Margin="4,0,0,0">
                                    <TextBlock Text="K" Style="{StaticResource KeycapText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Switch page" Style="{StaticResource TextSmall}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource KeycapBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                </Border>
                                <Border Style="{StaticResource KeycapBorder}" Margin="4,0,0,0">
                                    <TextBlock Text="1" Style="{StaticResource KeycapText}" />
                                </Border>
                                <TextBlock Text="–" Style="{StaticResource TextCaption}" Margin="4,0" />
                                <Border Style="{StaticResource KeycapBorder}">
                                    <TextBlock Text="5" Style="{StaticResource KeycapText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Settings" Style="{StaticResource TextSmall}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource KeycapBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                </Border>
                                <Border Style="{StaticResource KeycapBorder}" Margin="4,0,0,0">
                                    <TextBlock Text="," Style="{StaticResource KeycapText}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Close window" Style="{StaticResource TextSmall}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{StaticResource KeycapBorder}">
                                    <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
                                </Border>
                                <Border Style="{StaticResource KeycapBorder}" Margin="4,0,0,0">
                                    <TextBlock Text="W" Style="{StaticResource KeycapText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Right column: identity and version -->
            <StackPanel Grid.Column="2">

                <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                            <TextBlock Text="S" Style="{StaticResource TextH3}"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Steve" Style="{StaticResource TextBodyStrong}" Margin="0,12,0,0" />
                        <TextBlock Text="Offline profile" Style="{StaticResource TextCaptionSm}" Margin="0,3,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="Manage account"
                                HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False" />
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,32,0,8" />
                <Border Style="{StaticResource CardBorder}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Lantern Launcher" Style="{StaticResource TextBodyStrong}" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource TextCaptionSm}"
                                   Margin="0,4,0,0" />
                        <Border Style="{StaticResource SeparatorLine}" Margin="0,16,0,12" />
                        <TextBlock Text="Modrinth API · Mojang news feed · Inter typeface"
                                   Style="{StaticResource TextCaptionSm}" TextWrapping="Wrap" />
                        <Button Style="{StaticResource ButtonLink}" Content="Open project folder"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
