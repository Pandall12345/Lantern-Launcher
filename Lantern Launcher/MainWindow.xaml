<Window x:Class="LanternLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanternLauncher"
        xmlns:pages="clr-namespace:LanternLauncher.Pages"
        xmlns:shell="clr-namespace:LanternLauncher.Shell"
        xmlns:controls="clr-namespace:LanternLauncher.Controls"
        Title="Lantern Launcher"
        Width="1400" Height="880" MinWidth="960" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        PreviewMouseDown="Window_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MuteBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccountMenuRow" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceCardBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource CanvasBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource HairlineBrush}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" />
                <TextBlock Text="Lantern Launcher" Style="{StaticResource TextSmallStrong}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TextSmall}"
                           Foreground="{StaticResource AshBrush}"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource ButtonIcon}" ToolTip="Back"
                        Click="Back_Click"
                        IsEnabled="{Binding Navigation.CanGoBack}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource IconStrokeMute}" />
                </Button>
                <Button Style="{StaticResource ButtonIcon}" ToolTip="Forward" Margin="2,0,8,0"
                        Click="Forward_Click"
                        IsEnabled="{Binding Navigation.CanGoForward}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource IconStrokeMute}" />
                </Button>
                <Border Width="1" Height="16" Background="{StaticResource HairlineBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        Click="Minimize_Click" ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="Maximize"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        Click="Close_Click" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
        </Grid>

        <!-- Content: nav rail and the page host -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── NAV RAIL ── -->
            <Grid x:Name="NavRoot" Grid.Column="0" Background="{StaticResource CanvasBrush}">
                <Border HorizontalAlignment="Right" Width="1" Background="{StaticResource HairlineBrush}" />

                <!-- Shared highlight: the selected row's background is one sliding rounded rect, not a per-item colour flip -->
                <Border x:Name="NavPill" Height="36" Margin="12,0,12,0" CornerRadius="6"
                        Background="{StaticResource SurfaceCardBrush}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        IsHitTestVisible="False" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavPillShift" Y="16" />
                    </Border.RenderTransform>
                </Border>

                <!-- Shared indicator: a single Border sliding down the list -->
                <Border x:Name="NavIndicator" Width="2" Height="20" CornerRadius="1"
                        Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0,0,0,0" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavShift" Y="18" />
                    </Border.RenderTransform>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="NavList" Style="{StaticResource NavList}"
                             Margin="12,16,12,0" SelectedIndex="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Tag="Home" AutomationProperties.Name="Home">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Home" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Library" AutomationProperties.Name="Library">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGrid}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Library" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Browse" AutomationProperties.Name="Browse">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSearch}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Browse" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Packs" AutomationProperties.Name="Modpacks">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBox}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Modpacks" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Downloads" AutomationProperties.Name="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Downloads" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Settings" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGear}" Style="{StaticResource NavIconPath}" />
                                <TextBlock Text="Settings" Style="{StaticResource NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Account area -->
                    <Button Grid.Row="1" x:Name="AvatarButton" Style="{x:Null}" OverridesDefaultStyle="True"
                            Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Margin="12,0,12,14" Click="Avatar_Click"
                            FocusVisualStyle="{StaticResource FocusRing}"
                            ToolTip="Account" AutomationProperties.Name="Account">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14"
                                                Background="{StaticResource SurfaceCardBrush}"
                                                BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                                            <TextBlock Text="S" Style="{StaticResource TextSmallStrong}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Steve" Style="{StaticResource TextSmall}"
                                                       Foreground="{StaticResource BodyTextBrush}" />
                                            <TextBlock Text="Local account" Style="{StaticResource TextCaptionSm}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Popup x:Name="AccountPopup" PlacementTarget="{Binding ElementName=AvatarButton}"
                           Placement="Top" VerticalOffset="-6" HorizontalOffset="0"
                           AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
                        <Border Background="{StaticResource SurfaceElevatedBrush}"
                                BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="Steve" Style="{StaticResource TextCaptionSm}"
                                           Margin="10,6,10,8" />
                                <Button Content="Account settings" Click="AccountSettings_Click"
                                        Style="{StaticResource AccountMenuRow}" />
                                <Button Content="Sign out" Click="SignOut_Click"
                                        Style="{StaticResource AccountMenuRow}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <!-- ── PAGE HOST ── -->
            <Grid Grid.Column="1" ClipToBounds="False">
                <ContentControl x:Name="PageHost"
                                Content="{Binding CurrentRoute.Key}"
                                Opacity="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.ContentTemplateSelector>
                        <local:PageTemplateSelector>
                            <local:PageTemplateSelector.HomeTemplate>
                                <DataTemplate>
                                    <pages:HomePage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Home}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.HomeTemplate>
                            <local:PageTemplateSelector.LibraryTemplate>
                                <DataTemplate>
                                    <pages:LibraryPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Library}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.LibraryTemplate>
                            <local:PageTemplateSelector.BrowseTemplate>
                                <DataTemplate>
                                    <pages:BrowsePage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Browse}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.BrowseTemplate>
                            <local:PageTemplateSelector.PacksTemplate>
                                <DataTemplate>
                                    <pages:PacksPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Packs}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.PacksTemplate>
                            <local:PageTemplateSelector.DownloadsTemplate>
                                <DataTemplate>
                                    <pages:DownloadsPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Downloads}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.DownloadsTemplate>
                            <local:PageTemplateSelector.SettingsTemplate>
                                <DataTemplate>
                                    <pages:SettingsPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=SettingsPage}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.SettingsTemplate>
                            <local:PageTemplateSelector.ModDetailTemplate>
                                <DataTemplate>
                                    <pages:ModDetailPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=Detail}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.ModDetailTemplate>
                            <local:PageTemplateSelector.InstanceDetailTemplate>
                                <DataTemplate>
                                    <pages:InstancePage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=InstanceDetail}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.InstanceDetailTemplate>
                            <local:PageTemplateSelector.InstanceModsTemplate>
                                <DataTemplate>
                                    <pages:InstanceModsPage DataContext="{Binding Source={x:Static shell:AppShell.Instance}, Path=InstanceMods}" />
                                </DataTemplate>
                            </local:PageTemplateSelector.InstanceModsTemplate>
                        </local:PageTemplateSelector>
                    </ContentControl.ContentTemplateSelector>
                </ContentControl>

                <!-- Toast layer -->
                <ItemsControl ItemsSource="{Binding Toasts}" Panel.ZIndex="100"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,16,20,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:ToastMessage}">
                            <controls:ToastNotification />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- Ghost layer for a closing dropdown: the Popup vanishes instantly, so the fade has to run on the window -->
        <Canvas x:Name="FadeLayer" Panel.ZIndex="2000" IsHitTestVisible="False" />
    </Grid>
</Window>
