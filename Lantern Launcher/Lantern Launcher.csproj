<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Same name for product and assembly; the file name drops the space. -->
    <AssemblyName>LanternLauncher</AssemblyName>
    <RootNamespace>LanternLauncher</RootNamespace>
    <AssemblyTitle>Lantern Launcher</AssemblyTitle>
    <Product>Lantern Launcher</Product>
    <Description>Lantern Launcher — a quiet Minecraft launcher</Description>
    <Company>Lantern</Company>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
